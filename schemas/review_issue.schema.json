    "issue_id": {
      "title": "Issue Id",
      "type": "string"
    },
    "owner": {
      "default": "human",
      "title": "Owner",
      "type": "string"
    },
    "remediation": {
      "default": "",
      "title": "Remediation",
      "type": "string"
