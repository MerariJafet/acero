      "default": "",
      "title": "Expansion Reason",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "information_gain": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Information Gain"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
