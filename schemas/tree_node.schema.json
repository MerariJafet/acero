    },
    "priority": {
      "default": 0.5,
      "title": "Priority",
      "type": "number"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "prune_reason": {
      "default": "",
      "title": "Prune Reason",
      "type": "string"
    },
    "ref_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ref Id"
    },
    "result": {
