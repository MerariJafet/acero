{
  "$defs": {
    "ComprehensionStatus": {
      "enum": [
        "PASS",
        "PASS_WITH_SUPPORT",
        "BLOCKED_FOR_LEARNING",
        "HUMAN_OVERRIDE"
      ],
      "title": "ComprehensionStatus",
      "type": "string"
    },
    "KnowledgeStatus": {
      "description": "Where a learner stands on one concept. Transitions require evidence.",
      "enum": [
        "UNKNOWN",
        "EXPOSED",
        "RECOGNIZED",
        "PARTIALLY_UNDERSTOOD",
        "PROCEDURALLY_COMPETENT",
        "CONCEPTUALLY_UNDERSTOOD",
        "TRANSFER_CAPABLE",
        "MASTERED",
        "MISCONCEIVED",
        "DECAYED"
      ],
      "title": "KnowledgeStatus",
      "type": "string"
    }
  },
  "properties": {
    "assessments": {
      "items": {
        "type": "string"
      },
      "title": "Assessments",
      "type": "array"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "decision": {
      "title": "Decision",
      "type": "string"
    },
    "human_override": {
      "default": false,
      "title": "Human Override",
      "type": "boolean"
    },
    "misconceptions": {
      "items": {
        "type": "string"
      },
      "title": "Misconceptions",
      "type": "array"
    },
    "override_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Override Reason"
    },
    "required_concepts": {
      "items": {
        "type": "string"
      },
      "title": "Required Concepts",
      "type": "array"
    },
    "required_level": {
      "$ref": "#/$defs/KnowledgeStatus",
      "default": "CONCEPTUALLY_UNDERSTOOD"
    },
    "status": {
      "$ref": "#/$defs/ComprehensionStatus",
      "default": "PASS"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "decision"
  ],
  "title": "ComprehensionGateResult",
  "type": "object"
}
