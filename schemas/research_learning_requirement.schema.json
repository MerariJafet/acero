        "UNKNOWN",
        "EXPOSED",
        "RECOGNIZED",
        "PARTIALLY_UNDERSTOOD",
        "PROCEDURALLY_COMPETENT",
        "CONCEPTUALLY_UNDERSTOOD",
        "TRANSFER_CAPABLE",
        "MASTERED",
        "MISCONCEIVED",
        "DECAYED"
