# ACERO environment template — copy to .env and fill locally. NEVER commit real secrets.

# Runtime profile: development | production
ACERO_ENV=development

# Data / storage (local-first). SQLite by default.
ACERO_DB_URL=sqlite:///acero_data/acero.sqlite
ACERO_WORKSPACE=research

# LLM provider: mock | codex | ollama | claude | openai
# mock is deterministic and needs no network (default). codex shells out to the
# Codex CLI (`codex exec`) using your own Codex login. claude/openai API are gated
# OFF by policy.
ACERO_LLM_PROVIDER=mock
ACERO_CODEX_COMMAND=codex
# ACERO_CODEX_MODEL=          # leave blank for the Codex default model
ACERO_OLLAMA_HOST=http://127.0.0.1:11434
ACERO_OLLAMA_MODEL=llama3.1

# Paid provider keys are read ONLY if policy explicitly enables them (default: disabled).
# Leaving these blank is the safe default.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sandbox backend: subprocess | docker
ACERO_SANDBOX_BACKEND=subprocess
ACERO_SANDBOX_TIMEOUT_SEC=30
ACERO_SANDBOX_MEM_MB=1024
